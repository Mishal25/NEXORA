# --- Server-side only (never prefixed with VITE_, never sent to the browser) ---
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
GEMINI_MODEL=

# --- Firebase (optional; leave blank to run in Demo Mode with local storage) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
